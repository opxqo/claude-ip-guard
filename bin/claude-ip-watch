#!/usr/bin/python3
"""Monitor a fixed IPv4 baseline. Never targets Codex or unrelated shell processes."""
import fcntl
import json
import logging
from logging.handlers import RotatingFileHandler
import os
from pathlib import Path
import signal
import subprocess
import sys
import threading
import time
import claude_network as net


def targets():
    result = subprocess.run(['/bin/ps', '-axo', 'pid=,ppid=,comm='], capture_output=True, text=True)
    if result.returncode:
        raise ValueError('无法读取 Claude 进程状态')
    rows = {}
    for line in result.stdout.splitlines():
        p = line.strip().split(None, 2)
        if len(p) == 3:
            rows[int(p[0])] = (int(p[1]), p[2])
    roots = {pid for pid, (_, cmd) in rows.items() if (
        cmd == '/Applications/Claude.app/Contents/MacOS/Claude'
        or '/claude.app/Contents/MacOS/claude' in cmd
        or cmd.startswith(str(Path.home() / '.local/share/claude/versions/'))
        or cmd == str(Path.home() / '.local/bin/claude'))}
    chosen = set(roots)
    while True:
        children = {pid for pid, (parent, _) in rows.items() if parent in chosen}
        more = children - chosen
        if not more: break
        chosen |= more
    # Exclude this monitor and its descendants even when started by a CLI session.
    excluded = {os.getpid()} | {pid for pid, (_, cmd) in rows.items() if (
        '/Codex.app/' in cmd or '/codex/' in cmd or Path(cmd).name.lower() == 'codex')}
    while True:
        more = {pid for pid, (parent, _) in rows.items() if parent in excluded} - excluded
        if not more: break
        excluded |= more
    return {pid: rows[pid][1] for pid in chosen - excluded}


def terminate(known):
    for pid in known:
        identity = known[pid]
        if identity and net.process_identity(pid) == identity:
            try: os.kill(pid, signal.SIGKILL)
            except ProcessLookupError: pass


GRACE_SECONDS = 30
RETRY_SECONDS = 2


def notify(message):
    try:
        subprocess.Popen(['/usr/bin/osascript', '-e',
                          'display notification ' + json.dumps(message, ensure_ascii=False)
                          + ' with title "Claude 网络保护"'],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


class PausedProcesses:
    """Journal only the SIGSTOPs owned by this monitor; never resume a user's stop."""
    def __init__(self, baseline):
        self.baseline = baseline
        self.path = net.ROOT / 'ip-watch-paused.json'
        self.owned = {}
        self.since = None
        if self.path.exists():
            saved = json.loads(self.path.read_text())
            if saved['ip'] != baseline:
                raise ValueError('存在另一出口基准的暂停记录，请保持原基准恢复')
            self.owned = {int(pid): identity for pid, identity in saved['processes'].items()}
            self.since = saved.get('since')

    def save(self):
        temp = net.ROOT / ('paused-%s.tmp' % os.getpid())
        temp.write_text(json.dumps({'ip': self.baseline, 'processes': self.owned, 'since': self.since}))
        os.replace(temp, self.path)

    def pause(self, known):
        if self.since is None:
            self.since = time.time()
        for pid, identity in known.items():
            if pid in self.owned or not identity or net.process_identity(pid) != identity:
                continue
            result = subprocess.run(['/bin/ps', '-p', str(pid), '-o', 'state='], capture_output=True, text=True)
            if result.returncode or 'T' in result.stdout:
                continue
            # Persist before sending STOP so a replacement monitor can recover it.
            self.owned[pid] = identity
            self.save()
            if net.process_identity(pid) == identity:
                try: os.kill(pid, signal.SIGSTOP)
                except ProcessLookupError: self.owned.pop(pid, None)
            else:
                self.owned.pop(pid, None)
        self.save()

    def resume(self):
        for pid, identity in self.owned.items():
            if net.process_identity(pid) == identity:
                try: os.kill(pid, signal.SIGCONT)
                except ProcessLookupError: pass
        self.owned = {}
        self.since = None
        self.path.unlink(missing_ok=True)

    def close(self, terminate_processes=True):
        if terminate_processes and self.owned:
            terminate(self.owned)
        self.owned = {}
        self.since = None
        self.path.unlink(missing_ok=True)


def main():
    args = sys.argv[1:]
    dry = bool(args and args[0] == '--dry-run')
    if dry: args.pop(0)
    if len(args) != 1: return 2
    baseline = str(net.ipaddress.IPv4Address(args[0]))
    net.ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    if dry:
        try:
            net.probe(baseline)
            print('dry-run: baseline matches; no monitor or process changes')
            return 0
        except Exception as exc:
            print('dry-run: ' + str(exc)); return 1
    lock = open(net.ROOT / 'ip-watch.lock', 'a')
    try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        return 1
    try:
        net.validate_lease(baseline)
        paused = PausedProcesses(baseline)
    except Exception:
        lock.close()
        raise
    log = logging.getLogger('claude-ip-watch')
    log.setLevel(logging.INFO)
    handler = RotatingFileHandler(net.ROOT / 'ip-watch.log', maxBytes=1_000_000, backupCount=3)
    handler.setFormatter(logging.Formatter('%(asctime)s [%(process)d] %(message)s'))
    log.addHandler(handler)
    pidfile = net.ROOT / 'ip-watch.pid'
    pidfile.write_text('%s %s' % (os.getpid(), baseline))
    identity = net.process_identity(os.getpid())
    stopped = threading.Event()
    for sig in (signal.SIGTERM, signal.SIGINT): signal.signal(sig, lambda *_: stopped.set())
    seen = False
    started = time.monotonic()
    attempts = 0
    def publish(state, transport='', reason=''):
        temp = net.ROOT / ('health-%s.tmp' % os.getpid())
        temp.write_text(json.dumps({'pid': os.getpid(), 'identity': identity, 'ip': baseline,
                                   'heartbeat': time.time(), 'state': state,
                                   'transport': transport, 'reason': reason,
                                   'retry_count': attempts, 'paused_count': len(paused.owned),
                                   'retry_deadline': (paused.since + GRACE_SECONDS) if paused.since else None,
                                   'policy': 'pause-retry-v1'}))
        os.replace(temp, net.HEALTH)
    def current(known):
        for pid in targets():
            if pid not in known: known[pid] = net.process_identity(pid)
        return known
    def close_all(known, reason):
        publish('blocked', reason=reason)
        known.update(paused.owned)
        log.error('KILL: %s; matching Claude processes=%s', reason, len(known))
        terminate(known)
        paused.close(terminate_processes=False)
        notify(reason + '，已关闭 Claude')
        return 1
    log.info('watching baseline %s; transient failures pause/retry up to %ss', baseline, GRACE_SECONDS)
    try:
        while not stopped.is_set():
            before = targets()
            identities = {pid: net.process_identity(pid) for pid in before}
            if before:
                seen = True
                lease = net.ROOT / ('lease-%s.tmp' % os.getpid())
                lease.write_text(json.dumps({'ip': baseline, 'processes': identities}))
                os.replace(lease, net.ROOT / 'ip-watch-lease.json')
            elif seen or time.monotonic() - started > 60:
                log.info('no Claude process left, exiting'); break
            try:
                _, fingerprint = net.probe(baseline)
                if stopped.is_set(): break
                attempts = 0
                publish('healthy', fingerprint)
                if paused.since is not None:
                    log.info('RESUME: original IP confirmed; resuming %s processes', len(paused.owned))
                    paused.resume()
                    publish('healthy', fingerprint)
                    notify('出口 IP 已确认未变，Claude 已恢复')
            except net.ExitChanged as exc:
                return close_all(current(identities), '确认出口变化或冲突：' + str(exc))
            except Exception as exc:
                attempts += 1
                reason = str(exc)
                publish('retrying', reason=reason)
                first = paused.since is None
                paused.pause(current(identities))
                elapsed = max(0, time.time() - paused.since)
                publish('retrying', reason=reason)
                log.warning('PAUSE/RETRY %s: elapsed=%.1fs, paused=%s; %s', attempts, elapsed, len(paused.owned), reason)
                if first: notify('暂时无法确认出口，Claude 已暂停，正在重试')
                if elapsed >= GRACE_SECONDS:
                    return close_all(current(identities), '出口查询持续失败超过重试窗口：' + reason)
            stopped.wait(RETRY_SECONDS if paused.since is not None else 3)
    finally:
        if paused.owned:
            log.error('KILL: monitor stopped while Claude was paused')
            paused.close()
        publish('stopped')
        try:
            if pidfile.read_text().split()[0] == str(os.getpid()): pidfile.unlink()
        except (OSError, IndexError): pass
        lock.close()
        handler.close()
        log.removeHandler(handler)
    return 0


if __name__ == '__main__':
    sys.exit(main())
