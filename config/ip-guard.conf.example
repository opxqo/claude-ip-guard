# 启动检测以 ip.net.coffee 为准（与 https://ip.net.coffee/claude/ 同一方法）：
# 取 claude.ai 看到的出口 IP，trust_score（0–100）必须不低于这个数，且是住宅 IP、没有机房/VPN/代理/Tor/滥用标记、
# 不在 Claude 不提供服务的地区，通用出口也必须与 Claude 出口一致。CleanIP 的分数只作参考，不影响放行。
MIN_TRUST=80

# 网络波动（查不到出口 IP，但 IP 没有确认变化）时的处理：
#   pause = 暂停 Claude 并重试约 30 秒，恢复后继续（默认）
#   kill  = 立即关闭全部 Claude
# 出口 IP 一旦确认变化，两种策略都会立即关闭。控制台里切换后立刻生效。
ON_UNSTABLE=pause
